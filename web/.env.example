# Single-owner experimental edition. Same Postgres database as the Go API.
DATABASE_URL=postgresql://fact0:change-me@localhost:5432/fact0?sslmode=disable
# Generate with openssl rand -base64 32. No default secret is accepted.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
FACT0_BACKEND_URL=http://localhost:8000
# Optional public metadata only; browser API requests stay on the current origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DOCS_URL=https://docs.fact0.io
