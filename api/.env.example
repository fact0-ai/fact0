# Fact0 API - contributor local dev / ECS configuration
# Copy to api/.env and modify as needed:
#   cp api/.env.example api/.env
#
# Fact0 is a managed cloud platform (api.fact0.io). This file is for contributors
# running the API locally or deploying the Fact0 cloud stack - not a customer self-host path.
#
# Legacy LEDGERFLOW_* env vars are copied to FACT0_* at startup when unset.

# Server
FACT0_PORT=8000
FACT0_LOG_LEVEL=debug
FACT0_LOG_FORMAT=console

# Better Auth - JWKS URL for verifying dashboard JWTs on /v1/me/*.
# Format: ${BETTER_AUTH_URL}/api/auth/jwks
# Production: https://fact0.io/api/auth/jwks
# Leave blank to disable the dashboard surface (routes return 404),
# which is fine for SDK-only local dev.
FACT0_BETTER_AUTH_JWKS_URL=

# Optional `iss` claim allowlist. When set, JWTs whose issuer differs
# are rejected. Better Auth's JWT plugin uses the dashboard's baseURL
# verbatim - typically equals BETTER_AUTH_URL.
FACT0_BETTER_AUTH_ISSUER=

# Optional `azp` claim allowlist (comma-separated origins). When set,
# JWTs whose authorized party isn't in this list are rejected.
# Production example: https://app.fact0.io
FACT0_BETTER_AUTH_AUTHORIZED_PARTIES=

# Shared HMAC-SHA256 secret used by the dashboard's databaseHooks bridge
# to sign POSTs to /webhooks/auth. Must match AUTH_WEBHOOK_SECRET in
# web/.env.local. Leave blank to disable the webhook route (404).
FACT0_AUTH_WEBHOOK_SECRET=

# Email bridge (Go → Next.js Resend). Must match web EMAIL_WEBHOOK_SECRET.
# FACT0_EMAIL_BRIDGE_URL=https://fact0.io/api/internal/email
# FACT0_EMAIL_WEBHOOK_SECRET=

# CORS - comma-separated list of allowed browser origins.
# Leave blank in local dev (defaults to wildcard "*").
# Production (set automatically by enable-api-custom-domain.sh):
#   FACT0_CORS_ALLOWED_ORIGINS=https://app.fact0.io,https://fact0.io
FACT0_CORS_ALLOWED_ORIGINS=

# PostgreSQL
# Option A - full DSN (recommended for managed DBs: Neon, RDS, Supabase).
#   When set, all HOST/PORT/USER/PASSWORD/DATABASE/SSLMODE fields below are ignored.
#   Neon example:
#   FACT0_POSTGRES_DSN=postgresql://user:pass@ep-xxx.neon.tech/db?sslmode=require&channel_binding=require
FACT0_POSTGRES_DSN=

# Option B - individual connection fields (legacy; prefer Option A).
FACT0_POSTGRES_HOST=localhost
FACT0_POSTGRES_PORT=5432
FACT0_POSTGRES_USER=fact0
FACT0_POSTGRES_PASSWORD=fact0
FACT0_POSTGRES_DATABASE=fact0
FACT0_POSTGRES_SSLMODE=disable

# Copilot recording (Go API)
# Resume window for dashboard copilot sessions (transcript rows may
# live longer per plan). Default 7 days.
FACT0_COPILOT_SESSION_TTL_DAYS=7

# PostgreSQL connection pools (write/read split)
# MAX_CONNS is the total budget when WRITE/READ overrides are unset (70/30 split).
FACT0_POSTGRES_MAX_CONNS=25
FACT0_POSTGRES_MIN_CONNS=1
# Optional read replica DSN - list/verify/dashboard queries use this pool.
# FACT0_POSTGRES_READ_DSN=postgresql://...

# Ingest rate limiting (event-weighted: batch size counts against bucket)
FACT0_RATELIMIT_EVENTS_PER_SEC=50
FACT0_RATELIMIT_BURST=200
FACT0_RATELIMIT_EXECUTIONS_PER_MIN=120
# FACT0_RATELIMIT_DISABLED=true
# FACT0_RATELIMIT_BACKEND=memory   # or redis
# Upstash: use the Redis TCP URL (rediss://...), not the REST endpoint.
# FACT0_REDIS_URL=rediss://default:PASSWORD@HOST.upstash.io:6379

# Free-tier monthly event cap (override DB seed on new deploys; see migration 015).
# Retention days for free tier are set in the plans table (default 30).
FACT0_FREE_MONTHLY_EVENT_LIMIT=30000

# API key cache (in-process, per ECS task)
FACT0_AUTH_KEY_CACHE_TTL=60s

# HTTP server hardening
FACT0_READ_TIMEOUT=15s
FACT0_WRITE_TIMEOUT=60s
FACT0_IDLE_TIMEOUT=60s
FACT0_MAX_BATCH_BODY_BYTES=4194304

# Async ingest (Postgres outbox - default on)
FACT0_INGEST_ASYNC_DEFAULT=true
FACT0_INGEST_WORKER_ENABLED=true
FACT0_INGEST_WORKER_POLL_INTERVAL=200ms
FACT0_INGEST_WORKER_BATCH_SIZE=32
FACT0_INGEST_WORKER_MAX_ATTEMPTS=10
# Sync escape hatch for clients: X-Fact0-Sync: true or ?sync=true
# Kill switch: FACT0_INGEST_ASYNC_DEFAULT=false

# Razorpay PG Integration
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Cryptographic Signatures for Evidence Exports
FACT0_SIGNING_KEY=""
